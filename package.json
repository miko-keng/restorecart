{
  "name": "restorecart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/restorecart/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/restorecart/index.ts",
    "test": "NODE_ENV=test PAYPAL_ALLOW_SHARED_DEMO=true node --import tsx --test tests/restorecart*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:restorecart": "node --env-file-if-exists=.env --import tsx server/restorecart/index.ts",
    "start:restorecart": "NODE_ENV=production node --env-file-if-exists=.env --import tsx server/restorecart/index.ts",
    "test:restorecart": "NODE_ENV=test PAYPAL_ALLOW_SHARED_DEMO=true node --import tsx --test tests/restorecart*.test.ts",
    "restorecart:ai:on": "node --import tsx scripts/restorecart-ai.ts live",
    "restorecart:ai:off": "node --import tsx scripts/restorecart-ai.ts off",
    "restorecart:ai:fixture": "node --import tsx scripts/restorecart-ai.ts fixture",
    "test:restorecart:live-ai": "node --env-file-if-exists=.env --import tsx scripts/restorecart-live-check.ts",
    "restorecart:demo-accounts": "node --env-file-if-exists=.env --import tsx scripts/restorecart-demo-accounts.ts",
    "restorecart:storage:migrate": "node --env-file-if-exists=.env --import tsx scripts/restorecart-migrate-storage.ts",
    "test:ai-evals": "NODE_ENV=test PAYPAL_ALLOW_SHARED_DEMO=true node --import tsx --test --test-name-pattern=AI-E0 tests/restorecart-strengthening.test.ts",
    "restorecart:record-sample-chat": "node --env-file-if-exists=.env --import tsx scripts/record-sample-order-chat.ts",
    "restorecart:paypal:setup": "node --env-file-if-exists=.env --import tsx scripts/restorecart-paypal-setup.ts",
    "dev:shared-demo": "node --import tsx scripts/restorecart-shared-demo.ts"
  },
  "dependencies": {
    "@bryntum/schedulerpro": "npm:@bryntum/schedulerpro-trial@7.3.7",
    "@bryntum/schedulerpro-react": "7.3.7",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@libsql/client": "0.18.0",
    "@radix-ui/themes": "^3.3.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "decimal.js": "10.6.0",
    "express": "5.3.0",
    "image-size": "2.0.4",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "papaparse": "5.7.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
