# RestoreCart. Copy to .env locally; configure these in Render for hosting.
RESTORECART_PORT=4370
# Hosting: replace with the NEW service HTTPS origin (no path or trailing slash).
RESTORECART_BASE_URL=http://127.0.0.1:4370
RESTORECART_DB_PATH=.data/restorecart.sqlite
RESTORECART_SELLER_EMAIL=seller@example.com
RESTORECART_SELLER_PASSWORD=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Persistent live AI is controlled by restorecart.config.json.

# Browser UI switch. Enable hosted Bryntum only with applicable evaluation/deployment rights.
VITE_ENABLE_BRYNTUM=false
# AG Grid Community is always available; it needs no licence key.

# Keep 0 unless deployment proxy topology is verified. Render normally has one trusted ingress hop.
RESTORECART_TRUST_PROXY_HOPS=0
# Optional seller-configured WooCommerce TEST stores. Public root HTTPS domains only.
# No per-store allowlist or operator approval; the key below enables encrypted connection saving.
# 32 random bytes encoded as 64 hex characters. Keep server-only; changing it requires reconnecting stores.
WOOCOMMERCE_ENCRYPTION_KEY=

# Free external SQLite-compatible database (Turso/libSQL). No key belongs in VITE_*.
# Both values are required. When configured, all operational tables use this database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set true on the durable hosted service to refuse ephemeral fallback on missing configuration.
RESTORECART_REQUIRE_PERSISTENCE=false

# Optional Connect PayPal seller onboarding. Requires a PayPal platform/partner app
# with Partner Referrals access; ordinary single-merchant credentials are not enough.
# Use that platform app's sandbox client ID/secret above. No seller password is collected.
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
# true blocks new checkout without a verified seller, even if partner configuration is absent.
# Valid partner configuration automatically requires seller connection for new orders.
PAYPAL_REQUIRE_SELLER_CONNECTION=false

# Independent Gemini evidence checker: off (default), shadow, or enforce.
# Keep off until paired evaluation demonstrates a benefit. Shadow records checks
# without relaxing deterministic validation; both calls consume shared quotas.
RESTORECART_AI_VERIFIER=off
