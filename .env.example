# RestoreCart. Copy to .env locally; configure these in Render for hosting.
RESTORECART_PORT=4370
# Hosting: replace with the NEW service HTTPS origin (no path or trailing slash).
RESTORECART_BASE_URL=http://127.0.0.1:4370
RESTORECART_DB_PATH=.data/restorecart.sqlite
RESTORECART_SELLER_EMAIL=seller@example.com
RESTORECART_SELLER_PASSWORD=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Persistent live AI is controlled by restorecart.config.json.

# Browser UI switch. Enable hosted Bryntum only with applicable evaluation/deployment rights.
VITE_ENABLE_BRYNTUM=false
# AG Grid Community is always available; it needs no licence key.

# Keep 0 unless deployment proxy topology is verified. Render normally has one trusted ingress hop.
RESTORECART_TRUST_PROXY_HOPS=0
# Optional WooCommerce TEST stores only: comma-separated exact HTTPS origins (no path).
WOOCOMMERCE_TEST_ORIGINS=
# 32 random bytes encoded as 64 hex characters. Keep server-only; changing it requires reconnecting stores.
WOOCOMMERCE_ENCRYPTION_KEY=

# Free external SQLite-compatible database (Turso/libSQL). No key belongs in VITE_*.
# Both values are required. When configured, all operational tables use this database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set true on the durable hosted service to refuse ephemeral fallback on missing configuration.
RESTORECART_REQUIRE_PERSISTENCE=false
